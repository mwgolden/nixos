# Secrets for an ldap (lldap) host. Copy to secrets/<network>/<host>.env
# (gitignored) and set your own values.
#
# Password of lldap's "admin" user, at least 8 characters. Every deploy
# sets it, so changing it here and redeploying changes it in lldap.
LLDAP_ADMIN_PASSWORD=change-me-please
# Signs login tokens. At least 32 random characters, for example from
# 'openssl rand -base64 32'. Changing it logs everyone out of the web UI.
LLDAP_JWT_SECRET=replace-with-32-or-more-random-characters
