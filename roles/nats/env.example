# Client login for the nats VM. See README.md.
# Copy to secrets/<network>/<host>.env (gitignored) and set your own values.
#
# NATS_USER: letters, digits, '_' and '-'.
# NATS_PASSWORD: at least 16 of letters, digits and . _ ~ + / = -
# Generate one with:
#   echo "NATS_PASSWORD=$(openssl rand -base64 32)"
NATS_USER=app
NATS_PASSWORD=change-me-to-a-long-random-value
