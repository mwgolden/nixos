# Generated by Ansible from roles/nats/templates/nats.nix.j2. Do not edit on the host.
{ pkgs, lib, ... }:

let
  # NATS's own configuration format. $NATS_USER and $NATS_PASSWORD are
  # filled in from the environment when the server starts.
  conf = pkgs.writeText "nats.conf" ''
    server_name: "{{ nats_vm_name }}"
    port: {{ nats_port }}
    # Health and statistics, for the deploy's checks. Loopback only.
    http: "127.0.0.1:{{ nats_monitor_port }}"

    jetstream {
      store_dir: "/var/lib/nats"
      max_memory_store: {{ nats_max_memory }}
      max_file_store: {{ nats_max_file }}
    }

    authorization {
      user: $NATS_USER
      password: $NATS_PASSWORD
    }
  '';

  # Checked when the configuration is built, with stand-in login values.
  checked = pkgs.runCommand "nats.conf" { nativeBuildInputs = [ pkgs.nats-server ]; } ''
    NATS_USER='"check"' NATS_PASSWORD='"check-password"' nats-server -c ${conf} -t
    ln -s ${conf} $out
  '';
in
{
  systemd.services.nats.serviceConfig.ExecStart =
    lib.mkForce "${pkgs.nats-server}/bin/nats-server -c ${checked}";

  networking.firewall.allowedTCPPorts = [ {{ nats_port }} ];
}
