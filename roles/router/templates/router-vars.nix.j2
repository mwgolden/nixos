# Generated by Ansible from roles/router/templates/router-vars.nix.j2. Do not edit on the host.
# Values from the router's network file entry, used by configuration.nix.
{
  lanAddress = "{{ router_lan_ip }}";
  lanPrefixLength = {{ router_lan_prefix_length }};

  dhcpRangeStart = "{{ router_dhcp_range_start }}";
  dhcpRangeEnd = "{{ router_dhcp_range_end }}";
  dhcpLeaseTime = "{{ router_dhcp_lease_time }}";

  domain = "{{ router_domain }}";

  # Every host on the network: { name, ip }, answered as name and name.domain.
  hostRecords = [
{% for record in router_dns_records %}
    { name = "{{ record.name }}"; ip = "{{ record.ip }}"; }
{% endfor %}
  ];

  dnsServers = [
{% for server in router_dns_servers %}
    "{{ server }}"
{% endfor %}
  ];

  blockedNetworks = [
{% for network in router_blocked_networks %}
    "{{ network }}"
{% endfor %}
  ];

  # The DMZ: a second bridge for published hosts, which can't reach the
  # LAN except through dmzRules.
  dmz = {
    enable = {{ 'true' if router_dmz else 'false' }};
{% if router_dmz %}
    address = "{{ router_dmz.gateway }}";
    prefixLength = {{ router_dmz.prefix_length }};
    dhcp = {{ 'true' if router_dmz.dhcp else 'false' }};
{% if router_dmz.dhcp %}
    dhcpRangeStart = "{{ router_dmz.dhcp.start }}";
    dhcpRangeEnd = "{{ router_dmz.dhcp.end }}";
    dhcpLeaseTime = "{{ router_dmz.dhcp.lease_time | default('12h') }}";
{% endif %}
{% endif %}
  };

  # DMZ hosts' access to the LAN: proxy backends and reach: entries.
  dmzRules = [
{% for rule in router_dmz_rules %}
    {
      name = "{{ rule.name }}";
      srcAddress = "{{ rule.src_ip }}";
      dstAddress = "{{ rule.dst_ip }}";
      proto = "{{ rule.proto }}";
      port = {{ rule.port | int }};
    }
{% endfor %}
  ];

  # WireGuard. The private key is in {{ router_vpn_key_path }}, not here.
  vpn = {
    enable = {{ 'true' if router_vpn else 'false' }};
{% if router_vpn %}
    address = "{{ router_vpn.address }}";
    prefixLength = {{ router_vpn.prefix_length }};
    port = {{ router_vpn.port }};
    peers = [
{% for peer in router_vpn_peers %}
      # {{ peer.name }}
      { ip = "{{ peer.ip }}"; publicKey = "{{ peer.public_key }}"; }
{% endfor %}
    ];
{% endif %}
  };

  portForwards = [
{% for forward in router_port_forwards %}
    {
      name = "{{ forward.name }}";
      proto = "{{ forward.proto }}";
      wanPort = {{ forward.wan_port | int }};
      lanAddress = "{{ forward.lan_ip }}";
      lanPort = {{ forward.lan_port | int }};
    }
{% endfor %}
  ];
}
