# Generated by Ansible from roles/router/templates/router-vars.nix.j2. Do not edit on the host.
# Values from the router's network file entry, used by configuration.nix.
{
  lanAddress = "{{ router_lan_ip }}";
  lanPrefixLength = {{ router_lan_prefix_length }};

  dhcpRangeStart = "{{ router_dhcp_range_start }}";
  dhcpRangeEnd = "{{ router_dhcp_range_end }}";
  dhcpLeaseTime = "{{ router_dhcp_lease_time }}";

  domain = "{{ router_domain }}";

  # Every host on the network: { name, ip }, answered as name and name.domain.
  hostRecords = [
{% for record in router_dns_records %}
    { name = "{{ record.name }}"; ip = "{{ record.ip }}"; }
{% endfor %}
  ];

  dnsServers = [
{% for server in router_dns_servers %}
    "{{ server }}"
{% endfor %}
  ];

  blockedNetworks = [
{% for network in router_blocked_networks %}
    "{{ network }}"
{% endfor %}
  ];

  portForwards = [
{% for forward in router_port_forwards %}
    {
      name = "{{ forward.name }}";
      proto = "{{ forward.proto }}";
      wanPort = {{ forward.wan_port | int }};
      lanAddress = "{{ forward.lan_ip }}";
      lanPort = {{ forward.lan_port | int }};
    }
{% endfor %}
  ];
}
