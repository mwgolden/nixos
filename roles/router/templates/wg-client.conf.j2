# WireGuard configuration for {{ peer.name }}, a VPN client of network
# {{ vm.network.name }}. Generated by roles/router; redeploying the router
# rewrites it. Import it into a WireGuard app, or use
# 'wg-quick up ./{{ peer.name }}.conf'.
[Interface]
{% if peer.generated %}
PrivateKey = {{ lookup('file', router_vpn_dir ~ '/' ~ peer.name ~ '.key') }}
{% else %}
# This peer brought its own key: put its private key here.
PrivateKey = <private key for {{ peer.public_key }}>
{% endif %}
Address = {{ peer.ip }}/32
# The router's DNS server, which answers for the network's hosts.
DNS = {{ router_vpn.address }}, {{ router_domain }}

[Peer]
# The router
PublicKey = {{ router_vpn_public_key }}
Endpoint = {{ router_vpn.endpoint }}
# Only the network and the VPN go through the tunnel.
AllowedIPs = {{ router_vpn.allowed_ips | join(', ') }}
PersistentKeepalive = 25
