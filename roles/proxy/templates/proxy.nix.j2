# Generated by Ansible from roles/proxy/templates/proxy.nix.j2. Do not edit on the host.
# One site per proxy: entry in the network file.
{% if proxy_pki %}
# Certificates: this host's own, from {{ nixos_base_pki.instance }}
# (security.pki; docs/plans/completed/INTERNAL-CA.md), for every route's name.
{% set tls = 'tls /run/credentials/caddy.service/fullchain.pem /run/credentials/caddy.service/key.pem' %}
{% else %}
# Certificates: Caddy's own authority (tls internal).
{% set tls = 'tls internal' %}
{% endif %}
{
  services.caddy.virtualHosts = {
{% for route in proxy_routes %}
{% if route.external %}
    # From {{ route.host }}'s proxy: entry. External: anyone who reaches
    # the proxy, including through the router's port 443.
    "{{ route.fqdn }}".extraConfig = ''
      {{ tls }}
      reverse_proxy {{ route.backend_ip }}:{{ route.port }}
    '';
{% else %}
    # From {{ route.host }}'s proxy: entry. Internal: connections from
    # outside these subnets are dropped. route keeps the order as written.
    "{{ route.fqdn }}".extraConfig = ''
      {{ tls }}
      @outside not remote_ip {{ proxy_internal_sources | join(' ') }}
      route {
        abort @outside
        reverse_proxy {{ route.backend_ip }}:{{ route.port }}
      }
    '';
{% endif %}
{% endfor %}
  };

{% if proxy_pki %}
  # Copied in by systemd from {{ nixos_base_tls_dir }}, which only root can
  # read. A new certificate needs a restart, not a reload.
  systemd.services.caddy.serviceConfig.LoadCredential = [
    "fullchain.pem:{{ nixos_base_tls_dir }}/fullchain.pem"
    "key.pem:{{ nixos_base_tls_dir }}/key.pem"
  ];

  services.caddy.globalConfig = ''
    skip_install_trust
  '';
{% else %}
  services.caddy.globalConfig = ''
    # The VM doesn't need to trust its own certificates.
    skip_install_trust
    pki {
      ca local {
        name "{{ proxy_ca_name }}"
      }
    }
  '';
{% endif %}
}
