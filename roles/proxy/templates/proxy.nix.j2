# Generated by Ansible from roles/proxy/templates/proxy.nix.j2. Do not edit on the host.
# One site per proxy: entry in the network file.
{
  services.caddy.virtualHosts = {
{% for route in proxy_routes %}
{% if route.external %}
    # From {{ route.host }}'s proxy: entry. External: anyone who reaches
    # the proxy, including through the router's port 443.
    "{{ route.fqdn }}".extraConfig = ''
      tls internal
      reverse_proxy {{ route.backend_ip }}:{{ route.port }}
    '';
{% else %}
    # From {{ route.host }}'s proxy: entry. Internal: connections from
    # outside these subnets are dropped. route keeps the order as written.
    "{{ route.fqdn }}".extraConfig = ''
      tls internal
      @outside not remote_ip {{ proxy_internal_sources | join(' ') }}
      route {
        abort @outside
        reverse_proxy {{ route.backend_ip }}:{{ route.port }}
      }
    '';
{% endif %}
{% endfor %}
  };

  services.caddy.globalConfig = ''
    # The VM doesn't need to trust its own certificates.
    skip_install_trust
    pki {
      ca local {
        name "{{ proxy_ca_name }}"
      }
    }
  '';
}
