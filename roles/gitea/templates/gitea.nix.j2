# Generated by Ansible from roles/gitea/templates/gitea.nix.j2. Do not edit on the host.
{
  services.gitea.settings = {
    server = {
      HTTP_PORT = {{ gitea_http_port }};
      DOMAIN = "{{ gitea_route.fqdn if gitea_route else gitea_url_host }}";
      ROOT_URL = "{{ gitea_url | trim }}";
      SSH_DOMAIN = "{{ gitea_ssh_host | trim }}";
      SSH_PORT = {{ gitea_url_ssh_port }};
    };
{% if gitea_route %}
    # Behind the network's proxy, which serves HTTPS: the login cookie can
    # require it, and the proxy's forwarded client addresses are trusted.
    session.COOKIE_SECURE = true;
    security.REVERSE_PROXY_TRUSTED_PROXIES = "{{ gitea_proxy_ip | trim }}";
{% else %}
    # Served over plain HTTP, so the login cookie can't require HTTPS.
    session.COOKIE_SECURE = false;
{% endif %}
    service.DISABLE_REGISTRATION = {{ 'false' if gitea_allow_registration | bool else 'true' }};
  };

  networking.firewall.allowedTCPPorts = [ {{ gitea_http_port }} ];
}
