# Generated by Ansible from roles/gitea/templates/gitea.nix.j2. Do not edit on the host.
{
  services.gitea.settings = {
    server = {
      HTTP_PORT = {{ gitea_http_port }};
      DOMAIN = "{{ gitea_url_host }}";
      ROOT_URL = "http://{{ gitea_url_host }}:{{ gitea_url_http_port }}/";
      SSH_DOMAIN = "{{ gitea_url_host }}";
      SSH_PORT = {{ gitea_url_ssh_port }};
    };
    service.DISABLE_REGISTRATION = {{ 'false' if gitea_allow_registration | bool else 'true' }};
  };

  networking.firewall.allowedTCPPorts = [ {{ gitea_http_port }} ];
}
