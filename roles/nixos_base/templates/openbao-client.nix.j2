# Generated by Ansible from roles/nixos_base/templates/openbao-client.nix.j2. Do not edit on the host.
#
# This host's read-only token for its own secrets in its network's OpenBao
# (docs/plans/completed/NETWORK-SECURITY.md, 4.4). The token is in
# /etc/openbao/{{ vm.name }}.token, readable by root only, and kept out of
# the Nix store. To read the secrets as root:
#   set -a; . /etc/openbao/env; set +a
#   BAO_TOKEN=$(cat /etc/openbao/{{ vm.name }}.token) bao kv get {{ vm.network.name }}/{{ vm.name }}
{% if nixos_base_bao_client %}
{ pkgs, ... }:
{
  environment.systemPackages = [ pkgs.openbao ];

  environment.etc."openbao/env" = {
    mode = "0444";
    text = ''
      BAO_ADDR={{ nixos_base_bao_store.url }}
{% if nixos_base_bao_store.ca_file %}
      BAO_CACERT=/etc/openbao/ca.crt
{% endif %}
    '';
  };

  # The token is periodic: it lasts 768h from its last renewal. Deploys
  # renew it too, so this only matters between them.
  systemd.services.openbao-token-renew = {
    description = "Renew this host's OpenBao token";
    serviceConfig = {
      Type = "oneshot";
      EnvironmentFile = "/etc/openbao/env";
    };
    script = ''
      BAO_TOKEN=$(cat /etc/openbao/{{ vm.name }}.token) ${pkgs.openbao}/bin/bao token renew > /dev/null
    '';
  };
  systemd.timers.openbao-token-renew = {
    wantedBy = [ "timers.target" ];
    timerConfig = {
      OnCalendar = "daily";
      Persistent = true;
      RandomizedDelaySec = "1h";
    };
  };
}
{% else %}
# No token for this host: its network keeps no secrets in OpenBao, or its
# OpenBao hasn't made one yet.
{ }
{% endif %}
