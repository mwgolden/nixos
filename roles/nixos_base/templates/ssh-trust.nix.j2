# Generated by Ansible from roles/nixos_base/templates/ssh-trust.nix.j2. Do not edit on the host.
#
# Which SSH user CA this host trusts, and which certificate principals each
# local user accepts, from the network's security: block (the
# network_security filter). Static authorized_keys keep working either way:
# AuthorizedPrincipalsFile only applies to certificates.
{% if nixos_base_ssh_trust.ca_key %}
{
  services.openssh.settings = {
    TrustedUserCAKeys = "/etc/ssh/trusted-user-ca.pub";
    AuthorizedPrincipalsFile = "/etc/ssh/auth_principals/%u";
  };

  # The CA of {{ nixos_base_ssh_trust.instance }}.
  environment.etc."ssh/trusted-user-ca.pub" = {
    mode = "0444";
    text = ''
      {{ nixos_base_ssh_trust.ca_key }}
    '';
  };
{% for user, names in nixos_base_ssh_trust.principals.items() | sort %}

  environment.etc."ssh/auth_principals/{{ user }}" = {
    mode = "0444";
    text = ''
{% for name in names %}
      {{ name }}
{% endfor %}
    '';
  };
{% endfor %}
}
{% else %}
# This network uses static SSH keys only (administrative_identity: keys).
{ }
{% endif %}
