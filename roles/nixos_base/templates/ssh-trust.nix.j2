# Generated by Ansible from roles/nixos_base/templates/ssh-trust.nix.j2. Do not edit on the host.
#
# Which SSH user CA this host trusts, which certificate principals each
# local user accepts, and its own host certificate, from the network's
# security: block (the network_security filter). Static authorized_keys
# keep working either way: AuthorizedPrincipalsFile only applies to
# certificates.
{% if not nixos_base_ssh_trust.ca_key and not nixos_base_host_cert %}
# This network uses static SSH keys only (administrative_identity: keys).
{ }
{% else %}
{
{% if nixos_base_ssh_trust.ca_key %}
  services.openssh.settings = {
    TrustedUserCAKeys = "/etc/ssh/trusted-user-ca.pub";
    AuthorizedPrincipalsFile = "/etc/ssh/auth_principals/%u";
  };

  # The SSH user CA of {{ nixos_base_ssh_trust.instance }}.
  environment.etc."ssh/trusted-user-ca.pub" = {
    mode = "0444";
    text = ''
      {{ nixos_base_ssh_trust.ca_key }}
    '';
  };
{% for user, names in nixos_base_ssh_trust.principals.items() | sort %}

  environment.etc."ssh/auth_principals/{{ user }}" = {
    mode = "0444";
    text = ''
{% for name in names %}
      {{ name }}
{% endfor %}
    '';
  };
{% endfor %}
{% endif %}
{% if nixos_base_host_cert %}

  # Signed by the SSH host CA of {{ nixos_base_ssh_trust.instance }}; renewed by deploys.
  services.openssh.extraConfig = ''
    HostCertificate /etc/ssh/ssh_host_ed25519_key-cert.pub
  '';
{% endif %}
}
{% endif %}
