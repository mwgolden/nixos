# Generated by Ansible from roles/gitea_runner/templates/gitea_runner.nix.j2. Do not edit on the host.
{ config, lib, pkgs, ... }:

{
  services.gitea-actions-runner.instances.default = {
    enable = true;
    name = "{{ vm.name }}";
    # Gitea on {{ gitea_runner_gitea.name }}, directly on the network.
    url = "{{ gitea_runner_gitea_url }}";
    # TOKEN=<registration token>, written by roles/gitea_runner. Kept out of
    # the Nix store, which every user on the VM can read.
    tokenFile = "{{ gitea_runner_token_file }}";
    labels = [
{% for label in gitea_runner_labels %}
      "{{ label }}"
{% endfor %}
    ];
    settings = {
      runner.capacity = {{ gitea_runner_capacity }};
      # Node, which runs most actions, ignores the system's certificates
      # unless told; these include the network's own root, if it has one.
      runner.envs.NODE_EXTRA_CA_CERTS = "/etc/ssl/certs/ca-certificates.crt";
      # A fixed port, so the firewall can let the job containers in.
      cache = {
        enabled = true;
        port = {{ gitea_runner_cache_port }};
      };
{% if gitea_runner_docker %}
      container = {
        # The VM's certificates in each job container, so jobs trust the
        # same servers it does, such as Gitea behind the proxy.
        options = "-v /etc/ssl/certs/ca-certificates.crt:/etc/ssl/certs/ca-certificates.crt:ro";
        valid_volumes = [ "/etc/ssl/certs/ca-certificates.crt" ];
      };
{% endif %}
    };
  };

{% if gitea_runner_docker %}
  virtualisation.docker = {
    enable = true;
    # Old images and stopped containers would otherwise fill the disk.
    autoPrune = {
      enable = true;
      flags = [ "--all" "--filter" "until=168h" ];
    };
  };

  # Job containers reach the cache server from docker0 or a job's own
  # bridge (br-*). It stays closed to the rest of the network.
  networking.firewall.interfaces."docker0".allowedTCPPorts = [ {{ gitea_runner_cache_port }} ];
  networking.firewall.interfaces."br-+".allowedTCPPorts = [ {{ gitea_runner_cache_port }} ];
{% endif %}
{% if vm.data_disk %}

  # Docker's images, containers and volumes live on the separate data disk
  # (scsi1, serial "gitea_runner-data"), which roles/gitea_runner formats.
  # nofail keeps the VM bootable over SSH if the disk is missing; Docker
  # then refuses to start instead of filling the root disk.
  fileSystems."/var/lib/docker" = {
    device = "{{ data_disk_device }}";
    fsType = "ext4";
    options = [ "nofail" ];
  };
  systemd.services.docker = {
    requires = [ "var-lib-docker.mount" ];
    after = [ "var-lib-docker.mount" ];
  };
{% endif %}
{% if gitea_runner_proxy_ca %}

  # The proxy's own certificate authority (secrets/{{ vm.network.name }}/{{ vm.network.proxy }}-ca.crt),
  # for cloning from Gitea's address through the proxy. This network has
  # no security.pki.
  security.pki.certificateFiles = [ ./gitea-proxy-ca.crt ];
{% endif %}
}
