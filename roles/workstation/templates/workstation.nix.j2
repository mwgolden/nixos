# Generated by Ansible from roles/workstation/templates/workstation.nix.j2. Do not edit on the host.
{ pkgs, ... }:

{
  users.users."{{ workstation_user }}" = {
    isNormalUser = true;
    extraGroups = [ {{ '"wheel"' if workstation_sudo else '' }} ];
    openssh.authorizedKeys.keys = [
{% for key in workstation_ssh_keys %}
      "{{ key }}"
{% endfor %}
    ];
{% if workstation_password_hash %}
    # Written by roles/workstation, readable only by root.
    hashedPasswordFile = "{{ workstation_password_file }}";
{% endif %}
    packages = with pkgs; [
{% for package in workstation_packages %}
      {{ package }}
{% endfor %}
    ];
  };
}
