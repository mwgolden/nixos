# Optional secrets for the workstation's user. See README.md.
# Copy to secrets/<network>/<host>.env (gitignored) and set your own values.
# Without this file the user has no password and no secret variables.

# The password is for the Proxmox console. SSH stays key-only either way.
# Put the hash here, not the password. Make one with either of:
#   openssl passwd -6
#   mkpasswd -m yescrypt
# Wrap it in single quotes, since it contains $. Delete the line for no
# password.
WORKSTATION_PASSWORD_HASH='$6$change-me$replace-with-the-output-of-openssl-passwd'

# Secret environment variables: WORKSTATION_ENV_<NAME> sets <NAME> for the
# user's shells, SSH commands and VS Code Remote-SSH. Variables that aren't
# secret go under settings.environment in the network file instead.
# WORKSTATION_ENV_ANTHROPIC_API_KEY='sk-ant-...'
