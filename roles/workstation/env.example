# Optional password for the workstation's user. See README.md.
# Copy to secrets/<network>/<host>.env (gitignored) and set your own value.
# Without this file the user has no password and logs in with SSH keys only.
#
# The password is for the Proxmox console. SSH stays key-only either way.
# Put the hash here, not the password. Make one with either of:
#   openssl passwd -6
#   mkpasswd -m yescrypt
# Wrap it in single quotes, since it contains $.
WORKSTATION_PASSWORD_HASH='$6$change-me$replace-with-the-output-of-openssl-passwd'
