{
  networking.hostName = "{{ host_name }}";

  networking.interfaces.ens18.ipv4.addresses = [{
    address = "{{ host_ip }}";
    prefixLength = {{ host_prefix_length | default(network_prefix_length) }};
  }];

  networking.defaultGateway = "{{ host_gateway | default(network_gateway) }}";

  networking.nameservers = [
    "{{ host_nameserver | default(network_nameserver) }}"
  ];
}
