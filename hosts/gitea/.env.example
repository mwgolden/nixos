# Gitea admin login for the gitea VM. Used by hosts/gitea/gitea.yaml.
# Copy to .env (gitignored) and set your own values.
#
# The user name may contain letters, digits, '-', '_' and '.'. It can't be
# "admin", which Gitea reserves. The password needs at least 8 characters.
GITEA_ADMIN_USER=gitadmin
GITEA_ADMIN_PASSWORD=change-me-please
GITEA_ADMIN_EMAIL=gitadmin@example.com
